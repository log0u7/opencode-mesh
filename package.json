{
  "name": "@log0u7/opencode-mesh",
  "version": "0.4.1",
  "description": "Multi-session coordination for OpenCode: session coordination on one machine and a peer pool across LAN or Tailscale, with pairing, mailbox, and worktree locks.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/log0u7/opencode-mesh.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "oc-plugin": [
    "server"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:check": "pnpm run build && pnpm pack --dry-run",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:dist": "pnpm run build && node scripts/smoke-dist.mjs",
    "verify": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run smoke:dist",
    "prepare": "lefthook install"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@opencode-ai/plugin": "1.18.35",
    "@opencode-ai/sdk": "1.18.35",
    "@opencode/plugin": "2.0.26",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.1",
    "lefthook": "2.2.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
